// UnmarshalJSON decodes a {{ $t.Name }}, retaining any wire key this
// specification does not define in Unknown.
func ({{ $t.Recv }} *{{ $t.Name }}) UnmarshalJSON(data []byte) error {
	// The alias sheds this method, so the embedded decode does not recurse.
	type alias {{ $t.Name }}
	var base alias
	if err := json.Unmarshal(data, &base); err != nil {
		return err
	}
	*{{ $t.Recv }} = {{ $t.Name }}(base)

	var all map[string]json.RawMessage
	if err := json.Unmarshal(data, &all); err != nil {
		return err
	}
	for _, known := range []string{
{{- range $w := $t.KnownWire }}
		{{ quote $w }},
{{- end }}
	} {
		delete(all, known)
	}
	if len(all) > 0 {
		{{ $t.Recv }}.Unknown = all
	}
	return nil
}
{{- end }}
