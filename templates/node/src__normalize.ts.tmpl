{{- if not $t.Root }}
/** Parses a wire {{ $t.TSName }} into the camelCase model. */
export function parse{{ $t.Name }}{{ $t.TSGenerics }}(input: unknown, path = "{{ lower $t.Name }}"): {{ $t.TSName }}{{ $t.TSArgs }} {
  const o = record(input, path) ?? {}
  return {
{{- range $f := $t.Fields }}
{{- if not $f.Synthetic }}
{{- if $f.IsRefArray }}
    {{ $f.TSName }}: list(o[{{ quote $f.Wire }}], `${path}.{{ $f.Name }}`).map((x, i) => parse{{ $f.Elem }}{{ tsArgsFor $f.Elem }}(x, `${path}.{{ $f.Name }}[${i}]`)),
{{- else if $f.IsStringArray }}
    {{ $f.TSName }}: strList(o[{{ quote $f.Wire }}], `${path}.{{ $f.Name }}`),
{{- else if $f.IsEpoch }}
    {{ $f.TSName }}: num(o[{{ quote $f.Wire }}], `${path}.{{ $f.Name }}`),
{{- else if $f.IsMoney }}
{{- if $f.Optional }}
    {{ $f.TSName }}: optStr(o[{{ quote $f.Wire }}], `${path}.{{ $f.Name }}`),
{{- else }}
    {{ $f.TSName }}: str(o[{{ quote $f.Wire }}], `${path}.{{ $f.Name }}`),
{{- end }}
{{- else if eq $f.TSType "boolean" }}
    {{ $f.TSName }}: bool(o[{{ quote $f.Wire }}], `${path}.{{ $f.Name }}`),
{{- else if eq $f.TSType "Record<string, unknown>" }}
    {{ $f.TSName }}: record(o[{{ quote $f.Wire }}], `${path}.{{ $f.Name }}`),
{{- else if eq $f.TSType "ErrorCode" }}
    {{ $f.TSName }}: str(o[{{ quote $f.Wire }}], `${path}.{{ $f.Name }}`) as ErrorCode,
{{- else }}
    {{ $f.TSName }}: str(o[{{ quote $f.Wire }}], `${path}.{{ $f.Name }}`),
{{- end }}
{{- end }}
{{- end }}
{{- if $t.CaptureUnknown }}
    unknown: unknownFields(o, KNOWN_{{ upper $t.Name }}_WIRE) as {{ unknownParam $t.Name }},
{{- end }}
  }
}
{{ end }}
{{- end }}
