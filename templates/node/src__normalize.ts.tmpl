/*
 * Parsing helpers.
 *
 * These deliberately mirror Go's encoding/json semantics field for field, so
 * the two SDKs accept and reject exactly the same payloads:
 *
 *   - a missing field, or an explicit null, yields the zero value
 *   - a field present with the wrong type is an error, not a coercion
 *
 * The second rule matters most for money. A server that sends the number 12.5
 * where the protocol documents a string is broken, and a client that quietly
 * renders that as an empty balance is more dangerous than one that refuses the
 * response.
 */

/** Thrown when a field is present on the wire with the wrong type. */
export class SimpleFinParseError extends Error {
  override readonly name: string = "SimpleFinParseError"
  /** Dotted path to the offending field, e.g. "accounts[0].balance". */
  readonly path: string

  constructor(path: string, expected: string, got: unknown) {
    super(
      `simplefin: ${path} should be ${expected}, got ${Array.isArray(got) ? "array" : typeof got}`,
    )
    this.path = path
  }
}

function isRecord(v: unknown): v is Record<string, unknown> {
  return typeof v === "object" && v !== null && !Array.isArray(v)
}

function absent(v: unknown): boolean {
  return v === undefined || v === null
}

function str(v: unknown, path: string): string {
  if (absent(v)) return ""
  if (typeof v !== "string") throw new SimpleFinParseError(path, "a string", v)
  return v
}

function optStr(v: unknown, path: string): string | undefined {
  if (absent(v)) return undefined
  if (typeof v !== "string") throw new SimpleFinParseError(path, "a string", v)
  return v
}

function num(v: unknown, path: string): number {
  if (absent(v)) return 0
  if (typeof v !== "number" || !Number.isFinite(v)) {
    throw new SimpleFinParseError(path, "a number", v)
  }
  return v
}

function bool(v: unknown, path: string): boolean {
  if (absent(v)) return false
  if (typeof v !== "boolean") throw new SimpleFinParseError(path, "a boolean", v)
  return v
}

function record(v: unknown, path: string): Record<string, unknown> | undefined {
  if (absent(v)) return undefined
  if (!isRecord(v)) throw new SimpleFinParseError(path, "an object", v)
  return v
}

function list(v: unknown, path: string): unknown[] {
  if (absent(v)) return []
  if (!Array.isArray(v)) throw new SimpleFinParseError(path, "an array", v)
  return v
}

function strList(v: unknown, path: string): string[] {
  return list(v, path).map((x, i) => str(x, `${path}[${i}]`))
}

/**
 * Collects wire keys the specification does not define.
 *
 * The caller supplies the type via a parameter; nothing is validated at
 * runtime, because the shape is the server's to decide and asserting one here
 * would be inventing a guarantee the protocol does not make.
 */
function unknownFields(
  o: Record<string, unknown>,
  known: ReadonlySet<string>,
): UnknownFields {
  const out: UnknownFields = {}
  for (const [k, v] of Object.entries(o)) {
    if (!known.has(k)) out[k] = v
  }
  return out
}
