/**
 * Derives a stable connection id for a protocol v1 org, which has none of its
 * own. The fallback order is defined by the specification file so every
 * language derives the same id from the same response.
 */
function deriveConnId(org: {{ (index .V1Types 0).Name }}): string {
{{- range $s := .ConnIDFrom }}
  if ((org.{{ $s.TSName }} ?? "").trim() !== "") return (org.{{ $s.TSName }} ?? "").trim()
{{- end }}
  return ""
}

/**
 * Picks the most human-friendly label a v1 org offers. The v1 specification
 * requires either domain or name, so at least one is expected.
 */
function orgDisplayName(org: {{ (index .V1Types 0).Name }}): string {
  const name = (org.name ?? "").trim()
  return name !== "" ? name : (org.domain ?? "").trim()
}

/**
 * Flattens errlist or the deprecated errors array into Error objects.
 *
 * An entry may be a plain string (protocol v1) or an object (protocol v2). An
 * object without a recognizable message is preserved as its raw JSON rather
 * than rendered as an unhelpful placeholder — the protocol requires these be
 * shown to the user, so losing them defeats the point.
 *
 * The specification names the message field `msg`; `message` and
 * `description` are also accepted because servers have been observed using
 * them and the protocol requires that error text reach the user.
 */
export function normalizeErrors(input: unknown): SimpleFinError[] {
  const o = record(input, "response") ?? {}
  let entries = list(o["errlist"], "errlist")
  if (entries.length === 0) entries = list(o["errors"], "errors")

  return entries.map((entry): SimpleFinError => {
    // Protocol v1: a bare string with no code of its own.
    if (typeof entry === "string") {
      return {
        code: ErrorCodes.{{ .GeneralNakedConst }},
        msg: entry,
        connId: "",
        accountId: "",
        raw: entry,
      }
    }

    if (isRecord(entry)) {
      const msg =
        optStr(entry["msg"], "errlist.msg") ??
        optStr(entry["message"], "errlist.message") ??
        optStr(entry["description"], "errlist.description") ??
        // Never drop the text: fall back to the raw JSON. It is serialized
        // compactly so the result does not depend on the server's
        // whitespace, which also keeps this identical across language
        // targets.
        JSON.stringify(entry)

      // A non-string code is tolerated here rather than rejected: the
      // protocol requires that error text reach the user, and refusing the
      // whole response over a malformed error object would suppress it.
      const rawCode = typeof entry["code"] === "string" ? entry["code"] : undefined
      const code = rawCode ? normalizeErrorCode(rawCode as ErrorCode) : ErrorCodes.{{ .GeneralNakedConst }}

      return {
        code,
        msg,
        connId: typeof entry["conn_id"] === "string" ? entry["conn_id"] : "",
        accountId: typeof entry["account_id"] === "string" ? entry["account_id"] : "",
        raw: entry,
      }
    }

    const asJson = JSON.stringify(entry)
    return {
      code: ErrorCodes.{{ .GeneralNakedConst }},
      msg: asJson,
      connId: "",
      accountId: "",
      raw: asJson,
    }
  })
}

/**
 * Converts a decoded wire response into the public model.
 *
{{ tsDocBody " * " .NormalizationDoc }}
 */
export function normalizeAccountSet<AccountUnknown = UnknownFields, TransactionUnknown = UnknownFields>(
  input: unknown,
): AccountSet<AccountUnknown, TransactionUnknown> {
  const o = record(input, "response") ?? {}

  const connections = list(o["connections"], "connections").map((c, i) =>
    parseConnection(c, `connections[${i}]`),
  )
  const accounts: Account<AccountUnknown, TransactionUnknown>[] = []

  // Protocol v1 carries no connections array. Synthesize one entry per
  // distinct org so that v1 and v2 responses present identically.
  const seen = new Set(connections.map((c) => c.connId))

  for (const [i, rawAccount] of list(o["accounts"], "accounts").entries()) {
    const account = parseAccount<AccountUnknown, TransactionUnknown>(rawAccount, `accounts[${i}]`)
    const orgRaw = isRecord(rawAccount) ? rawAccount["org"] : undefined

    if (isRecord(orgRaw)) {
      const org = parseOrgV1(orgRaw, `accounts[${i}].org`)
      const connId = deriveConnId(org)
      if (account.connId === "") account.connId = connId
      if (connId !== "" && !seen.has(connId)) {
        seen.add(connId)
        connections.push({
          connId,
          name: orgDisplayName(org),
          orgId: org.id ?? "",
          orgName: org.name ?? "",
          orgUrl: org.url ?? "",
          sfinUrl: org.sfinUrl ?? "",
        })
      }
    }

    accounts.push(account)
  }

  return { errlist: normalizeErrors(o), connections, accounts }
}
