/**
 * Converts Unix seconds to a Date, treating zero and negative values as
 * absent. Every caller must agree on that rule — a bare zero check in one
 * place and a > 0 check in another is how pending transactions end up dated
 * to 1970 in one code path and null in the next.
 */
export function epochToDate(seconds: number | undefined): Date | null {
  if (seconds === undefined || seconds <= 0) return null
  return new Date(seconds * 1000)
}
