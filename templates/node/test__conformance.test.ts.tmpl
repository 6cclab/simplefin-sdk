import assert from "node:assert/strict"
import { readdirSync, readFileSync } from "node:fs"
import { join } from "node:path"
import { fileURLToPath } from "node:url"
import { test } from "node:test"

// Imported from the built output rather than src: this is what `npm install`
// actually delivers, so the conformance run exercises the published artifact
// including its generated .d.ts, not just the TypeScript sources.
import { canonicalJSON, normalizeAccountSet } from "../dist/index.js"

/**
 * The shared fixture directory. Every language target parses these same files
 * and must produce the same canonical output, which is what keeps the
 * implementations from drifting apart.
 */
const goldenDir = fileURLToPath(new URL("../../../spec/golden", import.meta.url))

/**
 * Parses every fixture and compares the canonical rendering against its
 * hand-authored .expect.json.
 *
 * The expectations are written by hand from the protocol specification, not
 * captured from this implementation's output. Regenerating them from the code
 * under test would make this assert only that the code agrees with itself.
 */
const fixtures = readdirSync(goldenDir).filter(
  (name) => name.endsWith(".json") && !name.endsWith(".expect.json"),
)

// An empty fixture directory would otherwise report as a pass.
test("fixtures are present", () => {
  assert.ok(fixtures.length > 0, `no fixtures found in ${goldenDir}`)
})

for (const name of fixtures) {
  test(`conformance: ${name.replace(/\.json$/, "")}`, () => {
    const input = JSON.parse(readFileSync(join(goldenDir, name), "utf8"))
    const expectPath = join(goldenDir, name.replace(/\.json$/, ".expect.json"))
    const want = readFileSync(expectPath, "utf8").trimEnd()

    const got = canonicalJSON(normalizeAccountSet(input)).trimEnd()

    assert.equal(got, want, `canonical output does not match ${name.replace(/\.json$/, ".expect.json")}`)
  })
}
